{
  "name": "okuyuki-tv",
  "version": "0.1.1",
  "description": "Okuyuki TV: view phone photos and videos on LG webOS TVs",
  "main": "src/index.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "serve": "enact serve",
    "pack": "enact pack",
    "pack-p": "enact pack -p && node scripts/prune-locales.mjs dist",
    "clean": "enact clean",
    "lint": "enact lint --strict .",
    "test": "enact test"
  },
  "enact": {
    "theme": "sandstone",
    "title": "Okuyuki TV"
  },
  "browserslist": [
    "chrome >= 87"
  ],
  "eslintConfig": {
    "extends": "enact-proxy"
  },
  "eslintIgnore": [
    "node_modules/*",
    "build/*",
    "dist/*"
  ],
  "dependencies": {
    "@enact/core": "4.9.8",
    "@enact/i18n": "4.9.8",
    "@enact/sandstone": "2.9.13",
    "@enact/spotlight": "4.9.8",
    "@enact/ui": "4.9.8",
    "@enact/webos": "4.9.8",
    "classnames": "2.5.1",
    "ilib": "14.22.0",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@enact/cli": "7.3.4",
    "eslint-config-enact-proxy": "1.0.9"
  }
}
